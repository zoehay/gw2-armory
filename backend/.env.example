# PostgreSQL DSN for local development
DEV_NO_MOCK_DB_DSN="host=localhost user=postgres password=postgres dbname=armory port=5432"
# PostgreSQL DSN for tests (also used when APP_ENV=test)
TEST_DB_DSN="host=localhost user=postgres password=postgres dbname=armory_test port=5432"

# Optional: space-separated allowed origins (default: https://localhost:5173 http://localhost:5173)
# CORS_ALLOW_ORIGIN=
# Optional: session cookie domain (default: localhost)
# DOMAIN=
# Optional: set to "test" to mock the GW2 API and use TEST_DB_DSN
# APP_ENV=
